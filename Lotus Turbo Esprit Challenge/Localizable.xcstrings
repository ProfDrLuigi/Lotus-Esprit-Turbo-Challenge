    "Choose a control or use Record, then press and release a button or move and release a stick. Existing button assignments are swapped within this player." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Eingabe aus oder klicke auf Aufnehmen und drücke und löse eine Taste oder bewege einen Stick und lasse ihn los. Bereits belegte Eingaben werden innerhalb dieses Spielerprofils getauscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a control or use Record, then press and release a button or move and release a stick. Existing button assignments are swapped within this player."
          }
        }
      }
    },
    "Choose difficulty, one or two players, control scheme and transmission in the original game menu. Single-player mode uses the original split-screen layout." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwierigkeitsgrad, ein oder zwei Spieler, Steuerungsart und Getriebe wählst du im ursprünglichen Spielmenü. Der Bildausschnitt für einen Spieler entspricht dem originalen geteilten Bildschirm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose difficulty, one or two players, control scheme and transmission in the original game menu. Single-player mode uses the original split-screen layout."
          }
        }
      }
    },
    "Click a key, then press and release its replacement. Each action has two key slots. Keys already in use are swapped, including between players." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke eine Taste an und drücke und löse anschließend die neue Taste. Jede Aktion hat zwei Tastenplätze. Bereits belegte Tasten werden getauscht, auch zwischen Spielern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click a key, then press and release its replacement. Each action has two key slots. Keys already in use are swapped, including between players."
          }
        }
      }
    },
